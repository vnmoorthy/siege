# Copy to .env and fill in. Missing keys degrade to honest fallbacks (see /api/providers).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
WANDB_API_KEY=
WEAVE_PROJECT=siege
AGENT_MODEL=claude-sonnet-5
DEFENDER_MODEL=claude-fable-5-1
REDTEAM_MODEL=gpt-6-astra
ROUND_SECONDS=90
# live | mock
SIEGE_MODE=
PUBLIC_BASE_URL=http://localhost:8000
# W&B Inference (used when no ANTHROPIC_API_KEY): open models hosted on CoreWeave, billed to WANDB_API_KEY
WANDB_ENTITY=
WANDB_AGENT_MODEL=openai/gpt-oss-20b
WANDB_DEFENDER_MODEL=deepseek-ai/DeepSeek-V4-Pro
WANDB_REDTEAM_MODEL=nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B
